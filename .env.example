# ========================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Guía de variables de entorno para Frontend y Backend (Vercel Serverless)
# IMPORTANTE: Nunca subas '.env' ni '.env.local' al control de versiones (Git).
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND (Vite / React) - Variables Públicas (VITE_*)
# Configurar en '.env.local' para desarrollo local y en Vercel
# --------------------------------------------------------
VITE_APP_TITLE="TaskManager SPA"
VITE_APP_ENV="development"

# Firebase Web App Configuration (Identificadores públicos de cliente)
VITE_FIREBASE_API_KEY="tu-api-key-aqui"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto-id"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="tu-messaging-sender-id"
VITE_FIREBASE_APP_ID="tu-app-id"
VITE_FIREBASE_MEASUREMENT_ID="tu-measurement-id-opcional"

# --------------------------------------------------------
# 2. SERVIDOR / VERCEL SERVERLESS (api/send-summary.ts)
# EXCLUSIVAS DEL SERVIDOR - NUNCA agregar prefijo VITE_ ni exponer al cliente
# Configurar en variables de entorno del proyecto en Vercel Dashboard
# --------------------------------------------------------

# Amazon SES (Simple Email Service - Región us-east-1)
AWS_ACCESS_KEY_ID="tu-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="tu-aws-secret-access-key"
AWS_REGION="us-east-1"
SES_FROM_EMAIL="identidad-verificada-ses@ejemplo.com"
SES_TO_EMAIL="destinatario-verificado-sandbox@ejemplo.com"

# Firebase Admin SDK (Para validar ID Tokens y consultar Firestore en el servidor)
# Opción A: Variables individuales
FIREBASE_PROJECT_ID="tu-proyecto-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-proyecto-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Opción B (Alternativa): JSON completo de la Service Account
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'
