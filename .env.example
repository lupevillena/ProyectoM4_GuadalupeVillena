# ========================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copia este archivo como '.env.local' y asigna tus valores reales de Firebase.
# IMPORTANTE: Nunca subas '.env' ni '.env.local' al control de versiones (Git).
# ========================================================

# Configuración de la aplicación
VITE_APP_TITLE="Task Management App"
VITE_APP_ENV="development"

# Firebase Web App Configuration (Proyecto: ProyectoM4)
# Estos valores se obtienen en: Firebase Console > Configuración del proyecto > Tus apps > SDK setup and configuration
VITE_FIREBASE_API_KEY="tu-api-key-aqui"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto-id"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="tu-messaging-sender-id"
VITE_FIREBASE_APP_ID="tu-app-id"
VITE_FIREBASE_MEASUREMENT_ID="tu-measurement-id-opcional"

# Backend / Notificaciones / AWS SES (Hitos posteriores)
VITE_API_BASE_URL="http://localhost:3000/api"
